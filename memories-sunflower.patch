+body[data-page="memories"] .sfm-b2{--s:clamp(30px,5.5vw,44px);right:-10px;bottom:-30px;animation-duration:11s}
+body[data-page="memories"] .sfmp{position:absolute;top:0;display:block;width:var(--s);height:calc(var(--s)*1.5);border-radius:55% 45% 60% 40%/70% 70% 30% 30%;
