+body[data-page="memories"] .mem:nth-child(even) .sfm-cn{right:auto;left:-11px;transform:scaleX(-1)}
+body[data-page="memories"] .sfmv{position:absolute;inset:0;z-index:-1;pointer-events:none}   /* behind the cards: blooms only peek out at the edges */
+body[data-page="memories"] .sfm-b{position:absolute;display:block;overflow:visible;height:auto;width:var(--s);opacity:.9;transform:rotate(var(--r,0deg)) scaleX(var(--f,1));animation:sfmSway 9s ease-in-out infinite alternate}
