+/* =====================================================================
+   SUNFLOWER THEME — phase 4: personal letter details. Decoration only, scoped to the letter page.
+   A faint line-art watermark, one small sunflower in the top-right corner, a few resting petals (all in one layer BEHIND the text,
+   clipped to the paper) + a tiny divider in the blank line above the signature. Text, ruled paper, tilt, word-fade, button: untouched.
+   Nothing here is in the text flow (absolute / out-of-flow), so wrapping and paper size cannot change. theme.sunflower:false removes every element.
+   ===================================================================== */
+@keyframes sfLnIn{from{opacity:0}}
+body[data-page="letter"] .paper{position:relative}   /* it already is a containing block (transform) — stated so the layer is anchored to the paper */
+body[data-page="letter"] .sfl-deco{position:absolute;inset:0;z-index:-1;overflow:hidden;pointer-events:none;border-radius:inherit;animation:sfLnIn 1.6s ease .5s both}
+body[data-page="letter"] .sfl-wm{position:absolute;right:-12%;top:52%;width:min(80%,330px);height:auto;aspect-ratio:1;transform:translateY(-50%) rotate(-10deg);opacity:.2}
+body[data-page="letter"] .sfl-wm .pe{fill:rgba(244,197,66,.2);stroke:#E8AA22;stroke-width:1.1}
+body[data-page="letter"] .sfl-wm .in{fill:none;stroke:#F4C542;stroke-width:.8}
+body[data-page="letter"] .sfl-wm .dc{fill:rgba(194,138,69,.3);stroke:#7a5128;stroke-width:1.2}
+body[data-page="letter"] .sfl-wm .sd{fill:#c28a45}
+body[data-page="letter"] .sfl-cn{position:absolute;top:8px;right:8px;width:clamp(46px,11vw,64px);height:auto;overflow:visible;rotate:6deg;transform-origin:50% 100%;opacity:.92;animation:sfSwayP 9s ease-in-out infinite}
+body[data-page="letter"] .sfl-pt{position:absolute;width:7px;height:11px;border-radius:100% 0;background:linear-gradient(160deg,var(--sf-soft),var(--sf-gold));opacity:.5;rotate:var(--r,0deg)}
+body[data-page="letter"] .paper .sign{position:relative}   /* anchor for the divider; no visual change */
+body[data-page="letter"] .sfl-dv{position:absolute;left:50%;top:-29px;width:132px;height:20px;margin-left:-66px;overflow:visible;pointer-events:none;animation:sfLnIn 1.6s ease 1s both}   /* centred in the one blank line above the signature */
+@media (prefers-reduced-motion:reduce){body[data-page="letter"] .sfl-cn{animation:none}}
