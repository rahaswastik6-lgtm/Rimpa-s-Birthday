+/* =====================================================================
+   SUNFLOWER THEME — phase 5: final page details. Decoration only, scoped to the final page.
+   One sunflower on the card's top-right corner, a small bloom beside the photo, a soft warm glow behind the ✨, a few petals drifting down
+   the side padding and a tiny signature in the bottom padding. Heading, message, photo, footer, button, tilt and heartbeat are untouched.
+   Everything is absolute inside ONE layer (last child of the card, behind the content) → nothing can move. theme.sunflower:false removes it all.
+   ===================================================================== */
+@keyframes sffIn{from{opacity:0}}
+@keyframes sffGlow{from{opacity:.65}to{opacity:1}}
+@keyframes sffSway{from{transform:rotate(calc(var(--r,0deg) - 5deg)) scaleX(var(--f,1))}to{transform:rotate(calc(var(--r,0deg) + 5deg)) scaleX(var(--f,1))}}
+@keyframes sffFall{0%{transform:translate3d(0,0,0) rotate(0);opacity:0}12%{opacity:.4}88%{opacity:.4}100%{transform:translate3d(var(--x),calc(var(--H,700px) - 14px),0) rotate(220deg);opacity:0}}   /* starts and ends inside the card */
+body[data-page="final"] .card{position:relative;isolation:isolate}   /* anchor + stacking scope for the layer (backdrop-filter already made it one) */
+body[data-page="final"] .sff{--pd:clamp(22px,5vw,40px);position:absolute;inset:0;margin:0;z-index:-1;pointer-events:none;animation:sffIn 1.6s ease .6s both}   /* --pd = the card's own padding */
+body[data-page="final"] .sff-clip{position:absolute;inset:0;overflow:hidden;border-radius:inherit}   /* glow + petals stay inside the rounded card; sunflowers may hang off its edge */
+body[data-page="final"] .sff-glow{position:absolute;left:50%;top:calc(var(--pd) + 40px);width:210px;height:210px;margin:-105px 0 0 -105px;border-radius:50%;   /* centred on the ✨ (5rem tall) */
+  background:radial-gradient(closest-side,rgba(255,205,100,.34),rgba(244,197,66,.1) 58%,transparent);animation:sffGlow 7s ease-in-out infinite alternate}
+body[data-page="final"] .sffp{position:absolute;top:0;display:block;width:var(--s);height:calc(var(--s)*1.5);border-radius:55% 45% 60% 40%/70% 70% 30% 30%;
+  background:linear-gradient(160deg,var(--sf-yellow),var(--sf-gold));opacity:0;animation:sffFall var(--t) linear var(--d) infinite}
+body[data-page="final"] .sffp.l{left:calc(var(--pd)*.5 - var(--s)*.5)}      /* centred in the left / right padding strip: text and photo never sit there */
+body[data-page="final"] .sffp.r{right:calc(var(--pd)*.5 - var(--s)*.5)}
+body[data-page="final"] .sff-a{position:absolute;top:-16px;right:-12px;width:clamp(50px,8vw,68px);height:auto;overflow:visible;rotate:7deg;transform-origin:50% 100%;opacity:.95;animation:sfSwayP 9s ease-in-out infinite}
+body[data-page="final"] .sff-m{position:absolute;display:block;overflow:visible;width:0;height:auto;opacity:0;transform:rotate(var(--r,0deg)) scaleX(var(--f,1));transition:opacity .4s;animation:sffSway 9s ease-in-out infinite alternate}   /* left/top/width are set from the photo's measured position */
+body[data-page="final"] .sff-m.on{opacity:.9}
+body[data-page="final"] .sff-dv{position:absolute;left:50%;bottom:calc(var(--pd)*.5 - 7px);width:88px;height:auto;margin-left:-44px;overflow:visible;opacity:.9}   /* inside the bottom padding, below the footer */
+@media (max-width:480px){body[data-page="final"] .sff-a{right:-5px}}
+@media (max-width:340px){body[data-page="final"] .sffp{display:none}}   /* the side strip is too narrow for petals here (the photo fills the card) */
+@media (prefers-reduced-motion:reduce){body[data-page="final"] .sff-a,body[data-page="final"] .sff-m,body[data-page="final"] .sff-glow{animation:none}body[data-page="final"] .sffp{display:none}}
